---
import Layout from '../layouts/Layout.astro';
import SongGrid from '../components/SongGrid.astro';
import SongWall from '../components/SongWall.astro';
import { getAllSongs } from '../lib/microcms';

const songs = await getAllSongs();
---

<Layout>
  <SongWall songs={songs} />
  <SongGrid songs={songs} />
</Layout>
