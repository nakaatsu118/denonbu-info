---
import shell from '../styles/Home.module.scss';
import songStyles from '../styles/Song.module.scss';
import styles from '../styles/List.module.scss';
import SongDialog from './SongDialog.astro';
import SongInfo from './SongInfo.astro';
import { ALL, formatDate, image, searchKey } from '../lib/microcms';
import type { Song } from '../types/song';

interface Props {
  songs: Song[];
}
const { songs } = Astro.props;

const EAGER_COUNT = 10;
const OTHER = 'other'; // エリアに属さないキャラクターをまとめる選択肢の値

const areas = new Map(songs.flatMap((song) => song.area.map((area) => [area.id, area.name] as const)));
const characters = [
  ...new Map(songs.flatMap((song) => song.characters.map((character) => [character.id, character] as const))).values(),
];
const others = characters.filter((character) => !character.area || !areas.has(character.area.id));
const otherIds = new Set(others.map((character) => character.id));

const areaKeys = (song: Song) =>
  song.all_flag
    ? [ALL]
    : [...song.area.map((area) => area.id), ...(song.characters.some((c) => otherIds.has(c.id)) ? [OTHER] : [])];

const groups = [
  ...[...areas].map(([id, name]) => ({ id, name, members: characters.filter((c) => c.area?.id === id) })),
  ...(others.length > 0 ? [{ id: OTHER, name: 'その他', members: others }] : []),
  { id: ALL, name: '電音部（全員）', members: [] },
].map((group) => ({ ...group, count: songs.filter((song) => areaKeys(song).includes(group.id)).length }));
const songCount = (characterId: string) => songs.filter((song) => song.characters.some((c) => c.id === characterId)).length;

// 新しい順に並んだ曲を、年ごとにまとめる。
const years = [...Map.groupBy(songs, (song) => formatDate(song.release_date).slice(0, 4))];
const eager = new Set(songs.slice(0, EAGER_COUNT));
---

<form class={styles.page} data-filters data-intro>
  <h1 class={shell.srOnly}>DENONBU MUSIC INFO - 電音部楽曲情報</h1>

  <button class={styles.scrim} type="button" data-filter-close tabindex="-1" aria-hidden="true"></button>
  <div class={styles.side} id="filters" role="search">
    <div class={styles.sheetHead}>
      <p>絞り込み</p>
      <div class={styles.headBtns}>
        <button class={styles.clear} type="button" data-clear hidden>クリア</button>
        <button class={styles.done} type="button" data-filter-close><span data-sheet-count>{songs.length}</span>曲を表示</button>
      </div>
    </div>
    <input type="search" name="q" placeholder="曲名・キャラクター" aria-label="検索" autocomplete="off" />
    <h2 id="area-title">エリア</h2>
    <div class={styles.opts} role="radiogroup" aria-labelledby="area-title" data-opts>
      <span class={styles.hover} data-hover aria-hidden="true"></span>
      <label class={styles.opt}>
        <input type="radio" name="area" value="" checked />
        すべて
        <span>{songs.length}</span>
      </label>
      {
        groups.map((group) => (
          <>
            <label class={styles.opt}>
              <input type="radio" name="area" value={group.id} />
              {group.name}
              <span>{group.count}</span>
            </label>
            {group.members.length > 0 && (
              <div class={styles.members}>
                <div>
                  {group.members.map((character) => (
                    <label class={styles.opt}>
                      <input type="radio" name="char" value={character.id} />
                      <i style={{ backgroundColor: character.color }} />
                      {character.name}
                      <span>{songCount(character.id)}</span>
                    </label>
                  ))}
                </div>
              </div>
            )}
          </>
        ))
      }
    </div>
  </div>

  <main class={styles.body}>
    <div class={styles.tools}>
      <output data-count>{songs.length}曲</output>
      <div class={styles.actions}>
      <button
        class={styles.filterBtn}
        type="button"
        data-filter-open
        aria-label="絞り込み"
        aria-controls="filters"
        aria-expanded="false"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M2.5 5h13M5 9h8M7.5 13h3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
      <button class={styles.sort} type="button" data-sort>
        <span data-sort-label>新しい順</span>
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <path
            d="M6 1.5v9M2.5 7 6 10.5 9.5 7"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      </div>
    </div>
    <div data-years>
      {
        years.map(([year, list]) => (
          <section class={styles.year} data-year>
            <h2 data-move>
              {year}
              <span data-year-count>{list.length}曲</span>
            </h2>
            <div class={styles.grid}>
              {list.map((song) => (
                <article
                  class={styles.tile}
                  data-tile
                  data-move
                  data-q={searchKey(song)}
                  data-areas={areaKeys(song).join(' ')}
                  data-chars={song.characters.map((c) => c.id).join(' ')}
                >
                  <button class={styles.face} type="button" data-face aria-label={`${song.title} の詳細を開く`}>
                    <img
                      src={image(song.jacket_image.url, 240)}
                      srcset={[240, 480, 720].map((w) => `${image(song.jacket_image.url, w)} ${w}w`).join(', ')}
                      sizes="(max-width: 720px) 46vw, 260px"
                      data-large={image(song.jacket_image.url, 960)}
                      alt={song.title}
                      width="240"
                      height="240"
                      loading={eager.has(song) ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </button>
                  <div class={styles.meta}>
                    <p class={styles.line}>
                      <span class={songStyles.date}>{formatDate(song.release_date).slice(5)}</span>
                      {song.all_flag ? (
                        <i style={{ backgroundColor: 'red' }} title="電音部" />
                      ) : (
                        song.characters.map((character) => (
                          <i style={{ backgroundColor: character.color }} title={character.name} />
                        ))
                      )}
                    </p>
                    <h3>{song.title}</h3>
                  </div>
                  <SongInfo song={song} />
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
    <p class={styles.empty} data-empty hidden>該当する曲がありません</p>
  </main>
</form>

<SongDialog />

<script>
  import { fold } from '../lib/fold';

  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const years = form.querySelector<HTMLElement>('[data-years]')!;
  const sections = [...years.querySelectorAll<HTMLElement>('[data-year]')];
  const movers = [...years.querySelectorAll<HTMLElement>('[data-move]')]; // 絞り込みと並び替えで位置が変わるもの
  const count = form.querySelector<HTMLElement>('[data-count]')!;
  const empty = form.querySelector<HTMLElement>('[data-empty]')!;
  const sort = form.querySelector<HTMLElement>('[data-sort]')!;
  const opts = form.querySelector<HTMLElement>('[data-opts]')!;
  const hover = opts.querySelector<HTMLElement>('[data-hover]')!;
  const filterBtn = form.querySelector<HTMLElement>('[data-filter-open]')!;
  const sheetCount = form.querySelector<HTMLElement>('[data-sheet-count]')!;
  const clear = form.querySelector<HTMLElement>('[data-clear]')!;
  const checkedChars = () => form.querySelectorAll<HTMLInputElement>('[name="char"]:checked');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const MOVE = { duration: 450, easing: 'cubic-bezier(0.77, 0, 0.175, 1)' }; // 画面内での移動
  const ENTER = { duration: 350, easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fill: 'backwards' as const }; // 新しく現れるもの
  const STAGGER = 25; // 現れる順にずらす間隔（ms）

  let lastChar = '';

  const filter = () => {
    const data = new FormData(form);
    const words = fold(String(data.get('q'))).split(/\s+/).filter(Boolean);
    const area = String(data.get('area') ?? '');
    const char = String(data.get('char') ?? '');
    lastChar = char;

    let total = 0;
    for (const section of sections) {
      let shown = 0;
      for (const el of section.querySelectorAll<HTMLElement>('[data-tile]')) {
        // キャラクターを選んでいるときは、エリアをまたいでその人の曲をすべて出す。
        const keys = char ? el.dataset.chars! : el.dataset.areas!;
        const key = char || area;
        el.hidden = !(words.every((word) => el.dataset.q!.includes(word)) && (!key || keys.split(' ').includes(key)));
        if (!el.hidden) shown++;
      }
      section.hidden = shown === 0;
      section.querySelector('[data-year-count]')!.textContent = `${shown}曲`;
      total += shown;
    }
    count.textContent = `${total}曲`;
    sheetCount.textContent = String(total);
    empty.hidden = total > 0;
    const active = words.length > 0 || !!area || !!char;
    filterBtn.toggleAttribute('data-active', active); // 絞り込み中の印
    clear.hidden = !active;
  };

  // 並びは最初から新しい順なので、年と曲をそれぞれ逆順に入れ直すだけで切り替わる。
  const reverse = () => {
    years.append(...[...years.children].reverse());
    for (const section of sections) {
      const grid = section.lastElementChild!;
      grid.append(...[...grid.children].reverse());
    }
    const asc = sort.toggleAttribute('data-asc');
    sort.querySelector('[data-sort-label]')!.textContent = asc ? '古い順' : '新しい順';
  };

  // 表示を変える前後の位置を比べ、画面内に残るものは前の位置から動かし、新しく入るものは下から現す。
  const transition = (change: () => void) => {
    if (reduce) return change();
    const onScreen = (r: DOMRect) => r.width > 0 && r.bottom > 0 && r.top < innerHeight;
    const before = new Map<HTMLElement, DOMRect>();
    for (const el of movers) {
      const r = el.getBoundingClientRect(); // 動いている途中なら、その位置から続ける
      if (onScreen(r)) before.set(el, r);
      for (const a of el.getAnimations()) a.cancel();
    }
    change();
    let entered = 0;
    for (const el of movers) {
      const r = el.getBoundingClientRect();
      if (!onScreen(r)) continue;
      const from = before.get(el);
      if (!from) {
        const delay = Math.min(entered++, 16) * STAGGER;
        el.animate([{ opacity: 0, transform: 'translateY(16px) scale(0.96)' }, { opacity: 1, transform: 'none' }], { ...ENTER, delay });
      } else if (from.left !== r.left || from.top !== r.top) {
        el.animate([{ transform: `translate(${from.left - r.left}px, ${from.top - r.top}px)` }, { transform: 'none' }], MOVE);
      }
    }
  };

  form.addEventListener('input', (e) => {
    // エリアを切り替えたら、前のエリアで選んでいたキャラクターは外す。
    if ((e.target as HTMLInputElement).name === 'area') for (const el of checkedChars()) el.checked = false;
    transition(filter);
  });
  // 選択中のキャラクターをもう一度押すと、選択を外してエリア全体に戻す。
  form.addEventListener('click', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name !== 'char' || el.value !== lastChar) return;
    el.checked = false;
    transition(filter);
  });
  form.addEventListener('submit', (e) => e.preventDefault());
  sort.addEventListener('click', () => transition(reverse));

  // --- マウスを載せた行へ、ハイライトを滑らせる
  const moveHover = (target: Element | null) => {
    const opt = target?.closest<HTMLElement>('label');
    if (!opt) return hover.removeAttribute('data-on');
    const a = opt.getBoundingClientRect();
    const b = opts.getBoundingClientRect();
    const place = () => {
      hover.style.transform = `translate(${a.left - b.left}px, ${a.top - b.top}px)`;
      hover.style.width = `${a.width}px`;
      hover.style.height = `${a.height}px`;
    };
    if (hover.hasAttribute('data-on')) return place();
    // 出ていないときは、移動を見せずにその場で現す。
    hover.style.transition = 'none';
    place();
    hover.offsetWidth; // 位置を確定させてから、動きを戻す
    hover.style.transition = '';
    hover.setAttribute('data-on', '');
  };
  opts.addEventListener('pointerover', (e) => {
    if (e.pointerType === 'mouse') moveHover(e.target as Element);
  });
  opts.addEventListener('pointerleave', () => moveHover(null));
  // キャラクターの欄が開閉して行がずれたら、いま載っている行に合わせ直す。
  opts.addEventListener('transitionend', (e) => {
    if (e.propertyName === 'grid-template-rows' && hover.hasAttribute('data-on')) moveHover(opts.querySelector('label:hover'));
  });

  // --- モバイルでは、絞り込みを下から出すシートにする（CSSで幅が狭いときだけ）
  const setSheet = (open: boolean) => {
    form.toggleAttribute('data-sheet', open);
    filterBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : ''; // 開いている間は後ろの一覧を送らない
  };
  filterBtn.addEventListener('click', () => setSheet(true));
  // 検索とエリア、キャラクターをまとめて外し、「すべて」に戻す。シートは開いたままにする。
  clear.addEventListener('click', () => {
    form.q.value = '';
    form.querySelector<HTMLInputElement>('[name="area"][value=""]')!.checked = true;
    for (const el of checkedChars()) el.checked = false;
    transition(filter);
  });
  form.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-filter-close]')) setSheet(false);
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && form.hasAttribute('data-sheet')) setSheet(false);
  });
  // 開いたまま画面を広げたら、PCの左の欄に戻す。
  matchMedia('(min-width: 721px)').addEventListener('change', (e) => e.matches && setSheet(false));

  // 最初の表示の動き（CSS）は一度きり。並び替えや絞り込みで要素を入れ直すと動きが再生し直されるので、
  // 終わったら、または先に操作されたら止める。
  const INTRO_MS = 2700;
  const endIntro = () => form.removeAttribute('data-intro');
  setTimeout(endIntro, INTRO_MS);
  form.addEventListener('pointerdown', endIntro, { once: true });
  form.addEventListener('keydown', endIntro, { once: true });

  filter(); // 再読み込みでフォームの値が復元されていても、表示を合わせる
</script>
